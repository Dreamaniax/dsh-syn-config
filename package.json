{
  "name": "dsh-syn-config",
  "version": "0.8.11",
  "private": false,
  "description": "Cross-platform (macOS + Windows) DeepSeek Harness plugin that syncs DSH config — skills, profile settings, AGENTS.md — with a private dsh-config repository.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test",
    "test:status": "node --test test/status.test.mjs",
    "install:local": "node scripts/install.mjs",
    "uninstall:local": "node scripts/uninstall.mjs",
    "verify:local": "node scripts/verify.mjs",
    "parity": "node scripts/parity.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sync",
    "config",
    "windows",
    "macos"
  ],
  "license": "MIT",
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dreamaniax/dsh-syn-config.git"
  },
  "homepage": "https://github.com/Dreamaniax/dsh-syn-config#readme",
  "bugs": {
    "url": "https://github.com/Dreamaniax/dsh-syn-config/issues"
  },
  "icon": "assets/icon-180.png"
}
